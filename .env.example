# Copiez ce fichier en « .env » pour tester en local (npx netlify dev).
# Sur Netlify, saisissez ces valeurs dans : Site configuration > Environment variables.
# Ne publiez JAMAIS le vrai fichier .env.

# Code d'accès de la caisse : choisissez-le vous-même (12 caractères ou plus). À saisir une fois dans Réglages sur chaque tablette.
CAISSE_TOKEN=

# Clé API SumUp (tableau de bord développeur SumUp)
SUMUP_API_KEY=

# Code marchand de votre compte SumUp (ex. MK10CL2A)
SUMUP_MERCHANT_CODE=

# Clé d'affiliation SumUp et identifiant d'application associé (même page développeur)
SUMUP_AFFILIATE_KEY=
SUMUP_APP_ID=

# Facultatif : identifiant du Solo à utiliser (sinon, le premier Solo appairé est choisi automatiquement)
# SUMUP_READER_ID=

# Facultatif : montant maximum accepté par commande, en centimes (défaut : 100000 = 1 000 €)
# MAX_AMOUNT_CENTS=50000
